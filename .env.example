SUPABASE_URL=###
SUPABASE_KEY=###

# Browser Realtime (F-02) — same URL and anon key as above; safe to expose to the client.
PUBLIC_SUPABASE_URL=###
PUBLIC_SUPABASE_ANON_KEY=###

# Local Supabase only — Google OAuth credentials for `supabase start` (see README).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional — Sprinter Draft/Coach use OpenRouter when set; app falls back without it.
# OPENROUTER_API_KEY=