SUPABASE_URL=###
SUPABASE_KEY=###

# Browser Realtime (F-02) — same URL and anon key as above; safe to expose to the client.
PUBLIC_SUPABASE_URL=###
PUBLIC_SUPABASE_ANON_KEY=###

# Local Supabase only — Google OAuth credentials for `supabase start` (see README).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional — Sprinter Draft/Coach use OpenRouter when set; app falls back without it.
# OPENROUTER_API_KEY=

# Server-only — Sprinter Analyst repo tokens and background jobs (never expose to client).
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — GitHub/GitLab OAuth for private repo linking (S-04).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URL=