---
import Layout from "@/layouts/Layout.astro";
import SessionRoom from "@/components/session/SessionRoom";
import {
  computeHumanAverage,
  formatHumanAverage,
  getAnalystStateForTask,
  getDefaultSessionId,
  getDisplayName,
  getLatestActiveTask,
  isDefaultDisplayName,
  listParticipation,
  sortParticipationByPoints,
} from "@/lib/session";
import type { AnalystVotePublic } from "@/lib/repo/types";
import type { Task, VoteParticipation } from "@/lib/session/types";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
let initialTask: Task | null = null;
let initialParticipation: VoteParticipation[] = [];
let initialHumanAverageFormatted: string | null = null;
let initialAnalyst: AnalystVotePublic | null = null;
let initialAnalystPending = false;
let initialDisplayName: string | null = null;
let needsDisplayName = false;
let realtimeAccessToken: string | null = null;
let planningSessionId: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  const sessionResult = await supabase.auth.getSession();
  realtimeAccessToken = sessionResult.data.session?.access_token ?? null;

  const defaultSessionResult = await getDefaultSessionId(supabase);
  planningSessionId = defaultSessionResult.data;

  const profileResult = await getDisplayName(supabase, user.id);
  if (!profileResult.error) {
    initialDisplayName = profileResult.data;
    needsDisplayName = isDefaultDisplayName(user.id, profileResult.data);
  } else {
    needsDisplayName = true;
  }

  const taskResult = await getLatestActiveTask(supabase);
  if (!taskResult.error && taskResult.data) {
    initialTask = taskResult.data;

    const participationResult = await listParticipation(supabase, taskResult.data.id);
    if (!participationResult.error && participationResult.data) {
      initialParticipation =
        taskResult.data.status === "revealed"
          ? sortParticipationByPoints(participationResult.data)
          : participationResult.data;

      if (taskResult.data.status === "revealed") {
        const points = initialParticipation
          .map((row) => row.story_points)
          .filter((value): value is number => value !== null);
        const average = computeHumanAverage(points);
        initialHumanAverageFormatted = average !== null ? formatHumanAverage(average) : null;
      }

      if (taskResult.data.status === "voting" || taskResult.data.status === "revealed") {
        const analystState = await getAnalystStateForTask(supabase, taskResult.data.id, taskResult.data.status);
        initialAnalyst = analystState.analyst;
        initialAnalystPending = analystState.analystPending;
      }
    }
  }
}
---

<Layout title="Planning session">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Planning session
      </h1>
      <p class="text-blue-100/80">
        Signed in as <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-4 max-w-md text-sm text-blue-100/60">
        Create tasks, vote blindly, and reveal the team average when ready.
      </p>

      {
        user ? (
          <SessionRoom
            userId={user.id}
            initialDisplayName={initialDisplayName}
            needsDisplayName={needsDisplayName}
            initialTask={initialTask}
            initialParticipation={initialParticipation}
            initialHumanAverageFormatted={initialHumanAverageFormatted}
            initialAnalyst={initialAnalyst}
            initialAnalystPending={initialAnalystPending}
            realtimeAccessToken={realtimeAccessToken}
            planningSessionId={planningSessionId}
            client:load
          />
        ) : null
      }

      <p class="mt-6">
        <a
          href="/dashboard"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Back to dashboard
        </a>
      </p>
    </div>
  </div>
</Layout>
