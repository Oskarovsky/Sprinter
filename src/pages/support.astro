---
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { site, supportLinks } from "@/lib/site";
---

<Layout title="Support">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div
      class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"
    >
    </div>
    <div
      class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"
    >
    </div>

    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />

      <div class="mx-auto max-w-2xl px-4 py-12 sm:py-16">
        <div class="mb-10 text-center">
          <h1
            class="mb-4 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-4xl font-bold text-transparent sm:text-5xl"
          >
            Support
          </h1>
          <p class="text-lg text-blue-100/70">
            Questions, feedback, or something not working? Here is how to reach the {site.name} team.
          </p>
        </div>

        <div class="space-y-6">
          <section class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
            <h2 class="mb-3 text-lg font-semibold text-white">About {site.name}</h2>
            <p class="text-sm leading-relaxed text-blue-100/70">
              {site.name} is a web app for Scrum teams to run planning-poker sessions in a shared room. {site.tagline}.
            </p>
          </section>

          <section class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
            <h2 class="mb-4 text-lg font-semibold text-white">Maintainers</h2>
            <ul class="space-y-3">
              {
                site.owners.map((owner) => (
                  <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                    <span class="font-medium text-white">{owner.name}</span>
                    <span class="text-sm text-blue-100/60">{owner.role}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
            <h2 class="mb-4 text-lg font-semibold text-white">Contact</h2>
            <dl class="space-y-4 text-sm">
              <div>
                <dt class="mb-1 font-medium text-purple-200">General inquiries</dt>
                <dd>
                  <a
                    href={supportLinks.email}
                    class="text-blue-100/80 transition-colors hover:text-white hover:underline"
                  >
                    {site.supportEmail}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="mb-1 font-medium text-purple-200">Report a bug or request a feature</dt>
                <dd class="leading-relaxed text-blue-100/70">
                  Open an issue on GitHub with steps to reproduce, what you expected, and what happened instead.
                  <a
                    href={supportLinks.issues}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-2 inline-block text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                  >
                    Open GitHub Issues →
                  </a>
                </dd>
              </div>
            </dl>
          </section>

          <p class="text-center text-sm text-blue-100/50">
            <a href="/" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
              >← Back to home</a
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
