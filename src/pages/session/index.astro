---
import Layout from "@/layouts/Layout.astro";
import SessionLobby from "@/components/session/SessionLobby";
import { listPlanningSessions } from "@/lib/session";
import { formatPlanningSessionRoom } from "@/lib/session/rooms";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
let initialRooms: ReturnType<typeof formatPlanningSessionRoom>[] = [];

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  const roomsResult = await listPlanningSessions(supabase);
  if (!roomsResult.error && roomsResult.data) {
    initialRooms = roomsResult.data.map(formatPlanningSessionRoom);
  }
}
---

<Layout title="Planning rooms">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Planning rooms
      </h1>
      <p class="text-blue-100/80">
        Signed in as <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-4 max-w-md text-sm text-blue-100/60">
        Pick an existing room or create a new one by name. Room URLs use kebab-case slugs.
      </p>

      {user ? <SessionLobby initialRooms={initialRooms} client:load /> : null}

      <p class="mt-6">
        <a
          href="/dashboard"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Back to dashboard
        </a>
      </p>
    </div>
  </div>
</Layout>
