---
import Layout from "@/layouts/Layout.astro";
import CreateTaskView from "@/components/session/CreateTaskView";
import { getSessionIdBySlug } from "@/lib/session";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const sessionSlug = Astro.params.slug ?? "";
let notFound = true;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user && sessionSlug) {
  const sessionResult = await getSessionIdBySlug(supabase, sessionSlug);
  if (!sessionResult.error && sessionResult.data) {
    notFound = false;
  }
}

if (notFound) {
  Astro.response.status = 404;
}
---

<Layout title={notFound ? "Room not found" : `New task — ${sessionSlug}`}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      {
        notFound ? (
          <>
            <h1 class="mb-4 text-2xl font-bold text-white">Room not found</h1>
            <p class="text-sm text-blue-100/70">
              No planning room matches <span class="font-mono text-white">{sessionSlug}</span>.
            </p>
            <p class="mt-6">
              <a
                href="/session"
                class="rounded-lg border border-purple-400/40 bg-purple-500/20 px-4 py-2 text-sm font-medium transition-colors hover:bg-purple-500/30"
              >
                Back to planning rooms
              </a>
            </p>
          </>
        ) : (
          <>
            <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
              New task
            </h1>
            <p class="text-sm text-blue-100/60">
              Room:{" "}
              <a href={`/session/${sessionSlug}`} class="font-mono text-purple-300 hover:underline">
                {sessionSlug}
              </a>
              {" · "}
              <a href="/session" class="text-purple-300 hover:underline">
                All rooms
              </a>
            </p>

            {user ? <CreateTaskView sessionSlug={sessionSlug} client:load /> : null}

            <p class="mt-6">
              <a
                href={`/session/${sessionSlug}`}
                class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
              >
                Back to room
              </a>
            </p>
          </>
        )
      }
    </div>
  </div>
</Layout>
